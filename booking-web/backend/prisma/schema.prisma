// Esquema de booking-web: buzón de solicitudes de la reserva online.
//
// booking-web NO es un calendario: la app de escritorio de la farmacia es la
// única fuente de verdad. Aquí solo se guarda:
//   - La publicación que envía la app (marca, textos legales, clave pública y
//     huecos libres).
//   - Las solicitudes, cifradas en el navegador del paciente con la clave
//     pública de la farmacia (este servidor no puede leerlas).
//   - Las peticiones de cancelación (un token opaco que solo la app sabe validar).
// La app recoge solicitudes y cancelaciones periódicamente y, al confirmar la
// recepción, se borran de aquí. Ver README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // postgresql por defecto (Render, Fly.io, Supabase...). Para autoalojar con
  // SQLite, ver README.md.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Última publicación de la app de escritorio (fila única)
model Publicacion {
  id            String   @id @default("singleton")
  datos         String // JSON: ver src/publicacion.ts
  actualizadaEn DateTime @updatedAt
}

// Solicitud de cita aún no recogida por la app
model Solicitud {
  id        String   @id @default(cuid())
  tipo      String // "dermo", "bio", "nutricion", "consulta" o "evento:<id>"
  fecha     String // YYYY-MM-DD
  hora      String // HH:mm
  sobre     String // JSON cifrado (ECDH P-256 + AES-256-GCM); ilegible para este servidor
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// El paciente pulsó "cancelar mi cita" en su email; la app decide si es válido
model Cancelacion {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}
