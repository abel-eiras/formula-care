# ==========================================
# booking-web backend — variables de entorno
# ==========================================

# Base de datos (Postgres por defecto; para SQLite ver README.md)
DATABASE_URL="postgresql://user:password@localhost:5432/booking_web"

PORT=4000

# Token compartido con la app de escritorio (Configuración → Reserva online →
# Generar). Mínimo 16 caracteres. Sin él, la app no puede sincronizar.
SYNC_TOKEN=

# Origen(es) del frontend, separados por comas
CORS_ORIGIN=http://localhost:5174

# "1" si el servidor está detrás de un proxy (Render, Fly.io, Nginx...)
TRUST_PROXY=

NODE_ENV=development

# reCAPTCHA Enterprise (OPCIONAL). Sin las tres variables no se exige captcha.
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_SITE_KEY=
