# ==========================================
# booking-web backend — variables de entorno
# ==========================================

# Base de datos. Por defecto el esquema usa "postgresql" (recomendado para un
# servicio siempre encendido en Render/Fly.io/Supabase/etc).
#   Postgres: postgresql://usuario:password@host:5432/nombre_bd
#   SQLite (autoalojado con disco persistente): cambia el "provider" en
#     prisma/schema.prisma a "sqlite" y usa: file:./booking.db
DATABASE_URL="postgresql://user:password@localhost:5432/booking_web"

# Puerto del servidor Express
PORT=4000

# Orígenes permitidos para CORS (coma-separados). Debe incluir el dominio
# donde se sirve el frontend de booking-web.
CORS_ORIGIN=http://localhost:5174

# URL pública base de este despliegue (se usa para construir los enlaces de
# confirmar/modificar/cancelar en los emails). Debe ser la URL del FRONTEND.
APP_URL=http://localhost:5174

# Clave de encriptación AES-256-GCM para datos de contacto de pacientes
# (nombre, email, teléfono). OBLIGATORIA. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Contraseña compartida del panel de personal (staff). Sin usuarios ni roles:
# cualquiera con esta contraseña puede revisar/aprobar/rechazar solicitudes.
STAFF_PASSWORD=

# Secreto para firmar la cookie de sesión de staff (JWT). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_SESSION_SECRET=

NODE_ENV=development

# ==========================================
# Email (opcional pero recomendado en producción)
# ==========================================
# Puede configurarse aquí (variables de entorno) o desde el panel de staff
# (tabla Configuracion, que tiene prioridad si está rellena). Sin ninguna de
# las dos, los emails se registran en consola en vez de enviarse (modo dry-run).

# Resend (más sencillo para hosting en la nube)
RESEND_API_KEY=

# SMTP (alternativa a Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ==========================================
# reCAPTCHA Enterprise (OPCIONAL)
# ==========================================
# Si RECAPTCHA_ENTERPRISE_API_KEY no está definida, no se exige ni se valida
# ningún captcha — solicitar-cita funciona sin configuración adicional.
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_SITE_KEY=
