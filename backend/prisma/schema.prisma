// Esquema de base de datos para Sistema de Gestión de Farmacias
// Arquitectura local-first: una instalación = una farmacia, base de datos SQLite embebida.
// La reserva pública de citas (con acceso desde internet) vive en booking-web/, un
// servicio aparte con su propia base de datos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELO DE USUARIO (Autenticación)
// ==========================================
model Usuario {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hash bcrypt
  nombre        String
  rol           String    @default("usuario") // "admin", "farmaceutico", "usuario"
  activo        Boolean   @default(true)
  ultimoAcceso  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tokensInvitacion TokenInvitacionUsuario[]

  @@index([email])
  @@index([rol])
}

// ==========================================
// MODELO DE PACIENTE
// ==========================================
// NOTA: Los campos name, phone y email están ENCRIPTADOS con AES-256-GCM
// Para búsquedas por email usar emailHash (SHA-256)
model Paciente {
  id          String   @id @default(cuid())
  name        String   // ENCRIPTADO: nombre del paciente
  age         Int
  sex         String   // "M", "F", "O"
  phone       String   // ENCRIPTADO: teléfono del paciente
  email       String?  // ENCRIPTADO: email del paciente
  emailHash   String?  // SHA-256 del email (para búsquedas exactas)
  birthDate   String?  // Fecha en formato ISO
  address     String?
  notes       String?
  lastVisit   String?  // Fecha en formato ISO
  origen      String   @default("manual") // "manual" = registrado por farmacia, "autoregistro" = formulario público
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  analisisDermo AnalisisDermo[]
  analisisBio   AnalisisBio[]
  programasNutricion ProgramaNutricion[]
  citas         Cita[]
  notificaciones Notificacion[]

  @@index([emailHash])
  @@index([origen])
}

// ==========================================
// MODELO DE ANÁLISIS DERMOCOSMÉTICO
// ==========================================
model AnalisisDermo {
  id                String   @id @default(cuid())
  pacienteId        String
  fecha             String   // Fecha en formato ISO
  // Datos básicos
  motivoConsulta    String?  // Motivo/Objetivo de la consulta
  // Valoración de la piel (JSON array)
  valoracionPiel    String   @default("[]") // JSON array: ["piel_grasa", "flacidez", etc.]
  // Hábitos y Salud (JSON array)
  habitos           String   @default("[]") // JSON array: ["sueño_irregular", "estrés", etc.]
  medicacionHabitual String?
  patologias        String?
  etapaHormonal     String?  // Solo para mujeres
  // Rutina Día (JSON object)
  rutinaDia         String?  // JSON: { higiene, contornoOjos, productoIntensivo, hidratacion, proteccionSolar }
  // Rutina Noche (JSON object)
  rutinaNoche       String?  // JSON: { limpieza, contornoOjos, productoIntensivo, hidratacion }
  // Cuidados Semanales (JSON object)
  cuidadosSemanales String?  // JSON: { exfoliante, mascarilla }
  // Suplementación
  suplementacionOral String?
  // Firma y seguimiento
  proximaRevision   String?  // Fecha en formato ISO
  farmaceutico      String?
  // Campos legacy (mantener para compatibilidad)
  skinType          String?
  phototype         String?
  concerns          String   @default("[]") // JSON array como string
  hydration         Float?
  sebum             Float?
  elasticity        Float?
  spots             Float?
  ph                Float?
  treatment         String?
  cleaning          String?
  sunProtection     String?
  supplements       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relación
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@index([fecha])
}

// ==========================================
// MODELO DE ANÁLISIS BIOQUÍMICO
// ==========================================
model AnalisisBio {
  id                    String   @id @default(cuid())
  pacienteId            String
  fecha                 String   // Fecha en formato ISO
  // Parámetros básicos
  glucemia              Float?   // Antes "glucose"
  cholesterol           Float?   // Colesterol total
  cholesterolHDL        Float?   // Colesterol HDL
  cholesterolLDL        Float?   // Colesterol LDL
  triglycerides         Float?
  // Parámetros avanzados
  hemoglobinaGlucosilada Float?  // HbA1c
  proteinaCReactiva     Float?   // PCR
  vitaminaD             Float?
  ferritina             Float?
  // Tensión arterial y pulsaciones
  systolic              Int?
  diastolic             Int?
  pulsaciones           Int?
  // Medidas corporales
  weight                Float?
  height                Float?
  perimetroAbdominal    Float?   // Perímetro abdominal en cm
  imc                   Float?   // Calculado automáticamente
  // Observaciones y recomendaciones
  observaciones         String?
  recomendaciones       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relación
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@index([fecha])
}

// ==========================================
// SERVICIO DE NUTRICIÓN (con seguimiento GLP-1 opcional)
// ==========================================
// Un programa agrupa todo el proceso de un paciente: datos de partida
// (motivo, antecedentes, historia GLP-1), las visitas y el registro de
// alimentación. La primera visita es la "inicial" y sirve de referencia para
// calcular la evolución de las siguientes.
model ProgramaNutricion {
  id                    String   @id @default(cuid())
  pacienteId            String
  fechaInicio           String   // Fecha en formato ISO
  estado                String   @default("activo") // "activo", "pausado", "finalizado"
  fechaFin              String?
  // Motivación y objetivo
  motivoConsulta        String?
  objetivoPrincipal     String?
  pesoObjetivo          Float?   // kg
  dietasPrevias         String?  // Texto libre con las dietas intentadas (vacío = ninguna)
  // Antecedentes
  antecedentes          String   @default("[]") // JSON array de ids de catálogo: ["diabetes_2", "hipertension", ...]
  otrosProblemasMedicos String?
  antecedentesFamiliares String?
  tabaco                String?  // "no", "exfumador", "si"
  alcohol               String?  // "nunca", "ocasional", "semanal", "diario"
  // Historia de tratamiento farmacológico para el peso
  glp1Previo            Boolean  @default(false)
  glp1PrevioFarmaco     String?
  glp1PrevioMotivoAbandono String?
  medicoPrescriptor     String?
  otroTratamientoPeso   String?  // Tratamientos distintos a GLP-1 (orlistat, naltrexona/bupropión...)
  farmaceutico          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paciente  Paciente               @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  visitas   VisitaNutricion[]
  registros RegistroAlimentacion[]

  @@index([pacienteId])
  @@index([estado])
}

// Visita del programa. La inicial y las de seguimiento comparten estructura
// para que todos los datos sean comparables entre sesiones.
model VisitaNutricion {
  id                    String   @id @default(cuid())
  programaId            String
  fecha                 String   // Fecha en formato ISO
  tipo                  String   // "inicial", "seguimiento"
  // Evolución percibida (solo tiene sentido en seguimiento)
  evolucionSubjetiva    String?  // "muy_buena", "buena", "regular", "dificultosa"
  adherencia            Int?     // 0-10
  motivacion            Int?     // 0-10
  // Medicación
  medicacionHabitual    String?
  suplementacion        String?
  // Tratamiento GLP-1 (sección opcional)
  glp1Activo            Boolean  @default(false)
  glp1Farmaco           String?  // id de catálogo (semaglutida_sc, tirzepatida...)
  glp1Dosis             String?  // Texto: "0,5 mg semanal"
  glp1FechaInicio       String?  // Inicio de la dosis actual
  glp1DosisOlvidadas    Int?     // Desde la última visita
  efectosSecundarios    String   @default("[]") // JSON: [{ id: "nauseas", intensidad: "leve" }]
  toleranciaObservaciones String?
  // Alimentación y hábitos
  cambioDieteticoIniciado Boolean?
  pautaDietetica        String?  // Estrategia, pauta, menú adaptado...
  comidasDia            Int?
  racionesProteinaDia   Int?
  racionesFrutaVerduraDia Int?
  picoteo               Boolean?
  picoteoFrecuencia     String?  // "ocasional", "diario", "varias_diarias"
  picoteoCausas         String   @default("[]") // JSON array de ids de catálogo
  aguaLitros            Float?
  suenoHoras            Float?
  suenoCalidad          String?  // "buena", "regular", "mala"
  estres                String?  // "bajo", "moderado", "alto"
  // Actividad física
  ejercicio             String?  // "no", "parcial", "si"
  ejercicioTipos        String   @default("[]") // JSON array de ids de catálogo
  ejercicioDiasSemana   Int?
  ejercicioMinutosSesion Int?
  ejercicioDetalle      String?
  // Antropometría, bioimpedancia y tensión
  peso                  Float?   // kg
  altura                Float?   // cm
  cintura               Float?   // cm
  cadera                Float?   // cm
  imc                   Float?   // Calculado en el servidor
  icc                   Float?   // Índice cintura-cadera, calculado en el servidor
  porcentajeGrasa       Float?
  masaGrasa             Float?   // kg
  masaMagra             Float?   // kg (masa libre de grasa)
  systolic              Int?
  diastolic             Int?
  // Valoración profesional
  dificultades          String?
  observaciones         String?
  objetivosProximaSesion String?
  recomendaciones       String?
  proximaRevision       String?  // Fecha en formato ISO
  farmaceutico          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  programa ProgramaNutricion @relation(fields: [programaId], references: [id], onDelete: Cascade)

  @@index([programaId])
  @@index([fecha])
}

// Registro de alimentación: el paciente lo apunta en papel y el farmacéutico
// lo transcribe. Cada fila es una ingesta (incluidos los picoteos).
model RegistroAlimentacion {
  id                    String   @id @default(cuid())
  programaId            String
  fecha                 String   // Día (YYYY-MM-DD)
  hora                  String?  // "HH:mm"
  momento               String   // "desayuno", "media_manana", "comida", "merienda", "cena", "recena", "picoteo"
  descripcion           String
  cantidad              String?  // "pequena", "normal", "grande"
  hambreAntes           Int?     // 0-10
  saciedadDespues       Int?     // 0-10
  sensaciones           String   @default("[]") // JSON array de ids de catálogo
  compania              String?  // "solo", "familia", "amigos", "trabajo"
  lugar                 String?  // "casa", "trabajo", "fuera", "otro"
  causaPicoteo          String?  // id de catálogo, solo si momento = "picoteo"
  notas                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  programa ProgramaNutricion @relation(fields: [programaId], references: [id], onDelete: Cascade)

  @@index([programaId])
  @@index([fecha])
}

// ==========================================
// MODELO DE CITA
// ==========================================
model Cita {
  id         String   @id @default(cuid())
  titulo     String
  pacienteId String
  fecha      String   // Fecha en formato ISO
  hora       String   // Formato "HH:mm"
  tipo       String   // "dermo", "bio", "consulta", "seguimiento"
  estado     String   @default("pendiente") // "pendiente", "confirmada", "cancelada", "completada"
  notas      String?
  recordatorioEnviado Boolean @default(false) // Si se ha enviado recordatorio
  confirmacionEnviada Boolean @default(false) // Si se ha enviado email de confirmación
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  notificaciones Notificacion[]

  @@index([pacienteId])
  @@index([fecha])
  @@index([estado])
}

// ==========================================
// MODELO DE NOTIFICACIÓN
// ==========================================
model Notificacion {
  id          String   @id @default(cuid())
  tipo        String   // "cita", "revision", "recordatorio"
  pacienteId  String?
  citaId      String?
  analisisId  String?  // ID del análisis (dermo o bio)
  titulo      String
  mensaje     String
  canal       String   // "email", "sms", "whatsapp", "interno"
  enviada     Boolean  @default(false)
  fechaEnvio  DateTime?
  leida       Boolean  @default(false)
  fechaLectura DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  paciente Paciente? @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  cita     Cita?     @relation(fields: [citaId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
  @@index([citaId])
  @@index([enviada])
  @@index([leida])
}

// ==========================================
// MODELO DE CONFIGURACIÓN (singleton, una fila por instalación)
// ==========================================
model Configuracion {
  id                    String   @id @default("singleton")
  // Datos de la farmacia
  farmaciaNombre        String?
  farmaciaDireccion     String?
  farmaciaCiudad        String?
  farmaciaTelefono      String?
  farmaciaEmail         String?
  farmaciaWeb           String?
  farmaciaWhatsapp      String?
  farmaciaLogo          String?  // Ruta al logo
  // Apariencia y marca (colores, tema)
  temaActivo            String?  @default("default") // "default", "porDefecto", "verde", "azul", "custom"
  coloresMarca          String?  // JSON: { "primario": "#79438f", "secundario": "#6495a8", ... }
  // Configuración de valoración bioquímica
  valoracionBioActiva   Boolean  @default(true) // Activar/desactivar valoración global
  parametrosReferencia  String   @default("{}") // JSON con valores de referencia por parámetro
  // Configuración de parámetros bioquímicos dinámicos
  // JSON: [{ id, label, unit, grupo, activo, orden }]
  parametrosBioConfig   String   @default("[]")

  // ==========================================
  // CONFIGURACIÓN RGPD Y LEGAL
  // ==========================================
  // Datos del responsable del tratamiento
  rgpdRazonSocial           String?  // Razón social de la empresa
  rgpdCif                   String?  // CIF/NIF de la empresa
  rgpdDireccionFiscal       String?  // Dirección fiscal completa
  rgpdEmailContacto         String?  // Email para solicitudes RGPD
  rgpdResponsable           String?  // Nombre del responsable del tratamiento
  rgpdDpo                   String?  // Delegado de Protección de Datos (opcional)

  // Textos legales configurables
  textoAvisoLegal           String?  // Texto completo del aviso legal
  textoPoliticaPrivacidad   String?  // Texto de la política de privacidad
  textoPoliticaCookies      String?  // Texto de la política de cookies
  textoConsentimiento       String?  // Texto del consentimiento informado

  // Configuración de consentimiento
  consentimientoRequerido   Boolean  @default(true)  // Requerir consentimiento al crear paciente
  consentimientoVersion     String?  @default("v1.0") // Versión actual del consentimiento
  retencionDatosMeses       Int      @default(60)     // Periodo de retención (5 años por defecto)

  // ==========================================
  // CONFIGURACIÓN DE EMAIL
  // ==========================================
  emailProvider         String?  @default("smtp") // "smtp" o "resend"
  resendApiKey          String?  // API Key de Resend (encriptada en producción)
  emailRemitente        String?  // Email del remitente
  emailNombreRemitente  String?  // Nombre del remitente
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean  @default(false)
  smtpAcceptSelfSigned  Boolean  @default(false)
  smtpUser              String?
  smtpPass              String?  // No exponer en respuestas API

  // ==========================================
  // CONFIGURACIÓN DE COPIAS DE SEGURIDAD
  // ==========================================
  backupPeriodicidad    String    @default("diaria") // "diaria" | "semanal" | "mensual" | "desactivada"
  backupCifrado         Boolean   @default(false)
  backupCifradoClave    String?   // Clave derivada (scrypt) de la contraseña del usuario — nunca la contraseña en claro
  backupCifradoSalt     String?   // Salt usado para derivar backupCifradoClave
  backupUltimaEjecucion DateTime? // Última vez que se generó una copia (manual o automática)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ==========================================
// MODELO DE CONFIGURACIÓN DE CALENDARIO (singleton, una fila por instalación)
// ==========================================
model ConfiguracionCalendario {
  id                String   @id @default("singleton")
  horariosPorTipo   String   @default("{}") // JSON: { "dermo": { "lunes": ["09:00-14:00"], ... }, "bio": {...} }
  fechasBloqueadas  String   @default("[]") // JSON: ["2026-01-20", "2026-01-21"]
  horasBloqueadas   String   @default("{}") // JSON: { "2026-01-20": ["10:00", "11:00"] }
  autoAceptar       Boolean  @default(false) // Auto-aceptar solicitudes en horarios habilitados
  duracionPorTipo   String   @default("{}") // JSON: { "dermo": 45, "bio": 20, "evento": 60 } (minutos)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==========================================
// MODELO DE EVENTO PERSONALIZADO
// ==========================================
model Evento {
  id                String   @id @default(cuid())
  nombre            String   // Ej: "Taller de automaquillaje"
  activo            Boolean  @default(true) // Si está activo y visible para solicitudes
  fechas            String   @default("[]") // JSON: ["2026-01-20", "2026-01-21", "2026-01-22"] - fechas específicas disponibles
  horas             String   @default("[]") // JSON: ["09:00-14:00", "16:00-19:00"] - rangos horarios
  duracion          Int      @default(60) // Duración en minutos
  maxAsistentes     Int      @default(1) // Número máximo de asistentes simultáneos
  descripcion       String?  // Descripción opcional del evento
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([activo])
  @@index([nombre])
}

// ==========================================
// SISTEMA DE EMAILS
// ==========================================

// Modelo de Plantilla de Email
model PlantillaEmail {
  id             String   @id @default(cuid())
  tipo           String   @unique // "confirmacion", "recordatorio", "cancelacion", "modificacion"
  nombre         String   // Nombre descriptivo de la plantilla
  asunto         String   // Asunto del email (soporta variables como {{nombrePaciente}})
  contenidoHtml  String   // HTML completo de la plantilla
  contenidoTexto String?  // Versión texto plano (opcional, fallback)
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([activa])
}

// Token de invitación para que un nuevo usuario establezca su contraseña
model TokenInvitacionUsuario {
  id        String    @id @default(cuid())
  usuarioId String
  token     String    @unique
  expiraEn  DateTime
  usado     Boolean   @default(false)
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([usuarioId])
  @@index([expiraEn])
}
