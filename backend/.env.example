# ===================================
# FORMULA CARE - VARIABLES DE ENTORNO (backend local)
# ===================================
# Copia este archivo a .env y configura los valores.
# En la app de escritorio (Tauri) estas variables se generan/gestionan
# automáticamente; este archivo es para desarrollo o para ejecutar el
# backend de forma independiente.

# ===================================
# BASE DE DATOS (SQLite local)
# ===================================
# Instalación local de escritorio: un único fichero SQLite por farmacia.
DATABASE_URL="file:./dev.db"

# ===================================
# SERVIDOR
# ===================================
NODE_ENV=development
PORT=3000

# ===================================
# SEGURIDAD
# ===================================
# Clave secreta para JWT (CAMBIAR SIEMPRE, incluso en instalaciones locales)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-caracteres

# ===================================
# ENCRIPTACION DE DATOS SENSIBLES
# ===================================
# Clave AES-256 para encriptar datos de pacientes (nombre, telefono, email)
# IMPORTANTE: Genera una clave segura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA pierdas esta clave o los datos encriptados seran irrecuperables
ENCRYPTION_KEY=tu_clave_de_32_bytes_en_hexadecimal_64_caracteres_aqui

# ===================================
# CORS Y FRONTEND
# ===================================
# URLs permitidas (separar por comas). En la app de escritorio el frontend
# se sirve desde el propio webview de Tauri, por lo que normalmente solo
# hace falta para desarrollo con `npm run dev`.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# URL del frontend (para enlaces en emails, ej. invitación a crear contraseña)
FRONTEND_URL=http://localhost:5173

# ===================================
# EMAIL - Opcion 1: SMTP
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-contrasena-de-aplicacion
# SMTP_FROM=tu-email@gmail.com

# ===================================
# EMAIL - Opcion 2: Resend
# ===================================
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ===================================
# CREDENCIALES INICIALES (usado por seed.ts)
# ===================================
# Cambia estas credenciales antes o justo después del primer arranque.
ADMIN_EMAIL=admin@farmacia.local
ADMIN_PASSWORD=changeme123
