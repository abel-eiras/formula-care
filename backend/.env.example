# ===================================
# FARMACIA PONTEVEA - VARIABLES DE ENTORNO
# ===================================
# Copia este archivo a .env y configura los valores

# ===================================
# BASE DE DATOS
# ===================================
# Desarrollo (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Produccion (PostgreSQL) - Descomentar y configurar
# DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?schema=public"

# ===================================
# SERVIDOR
# ===================================
NODE_ENV=development
PORT=3000

# ===================================
# SEGURIDAD
# ===================================
# Clave secreta para JWT (CAMBIAR EN PRODUCCION)
JWT_SECRET=farmacia-pontevea-secret-key-2026

# Saltar autenticacion (solo desarrollo)
SKIP_AUTH=false

# ===================================
# CORS
# ===================================
# URLs permitidas (separar por comas)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ===================================
# URL DE LA APLICACION
# ===================================
# URL base para enlaces en emails
APP_URL=http://localhost:5173

# ===================================
# EMAIL - Opcion 1: SMTP
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-contrasena-de-aplicacion
# SMTP_FROM=tu-email@gmail.com

# ===================================
# EMAIL - Opcion 2: Resend
# ===================================
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ===================================
# CREDENCIALES INICIALES (usado por seed.ts)
# ===================================
SUPERADMIN_EMAIL=superadmin@sistema.local
SUPERADMIN_PASSWORD=superadmin123
ADMIN_EMAIL=admin@farmaciapontevea.com
ADMIN_PASSWORD=admin123
