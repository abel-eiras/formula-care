# ===================================
# FARMACIA PONTEVEA - VARIABLES DE ENTORNO
# ===================================
# Copia este archivo a .env y configura los valores

# ===================================
# BASE DE DATOS (PostgreSQL - Supabase)
# ===================================
# Formato: postgresql://usuario:password@host:5432/nombre_db?sslmode=require
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?sslmode=require"

# ===================================
# SERVIDOR
# ===================================
NODE_ENV=development
PORT=3000

# ===================================
# SEGURIDAD
# ===================================
# Clave secreta para JWT (CAMBIAR EN PRODUCCION)
JWT_SECRET=farmacia-pontevea-secret-key-2026

# Saltar autenticacion (solo desarrollo)
SKIP_AUTH=false

# ===================================
# ENCRIPTACION DE DATOS SENSIBLES
# ===================================
# Clave AES-256 para encriptar datos de pacientes (nombre, telefono, email)
# IMPORTANTE: Genera una clave segura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA pierdas esta clave o los datos encriptados seran irrecuperables
ENCRYPTION_KEY=tu_clave_de_32_bytes_en_hexadecimal_64_caracteres_aqui

# ===================================
# CORS
# ===================================
# URLs permitidas (separar por comas)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ===================================
# URL DE LA APLICACION
# ===================================
# URL base para enlaces en emails
APP_URL=http://localhost:5173

# ===================================
# EMAIL - Opcion 1: SMTP
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-contrasena-de-aplicacion
# SMTP_FROM=tu-email@gmail.com

# ===================================
# EMAIL - Opcion 2: Resend
# ===================================
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ===================================
# reCAPTCHA Enterprise (formulario público de solicitud de cita)
# ===================================
# Si se define RECAPTCHA_ENTERPRISE_API_KEY, el backend exigirá un token válido al crear solicitudes.
# Proyecto: formulafarma. Site key (público): 6Lc_wHosAAAAAF0_2KG7b0YqJNJVcot-RphIp1K1
# RECAPTCHA_ENTERPRISE_API_KEY=tu_api_key_de_google_cloud
# RECAPTCHA_ENTERPRISE_PROJECT_ID=formulafarma
# RECAPTCHA_ENTERPRISE_SITE_KEY=6Lc_wHosAAAAAF0_2KG7b0YqJNJVcot-RphIp1K1
# En frontend .env (opcional): VITE_RECAPTCHA_SITE_KEY=6Lc_wHosAAAAAF0_2KG7b0YqJNJVcot-RphIp1K1

# ===================================
# CREDENCIALES INICIALES (usado por seed.ts)
# ===================================
SUPERADMIN_EMAIL=superadmin@sistema.local
SUPERADMIN_PASSWORD=superadmin123
ADMIN_EMAIL=admin@farmaciapontevea.com
ADMIN_PASSWORD=admin123
